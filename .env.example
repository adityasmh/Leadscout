# Leadscout configuration. Copy to `.env` (`cp .env.example .env`) and edit.
# `npm start` loads `.env` automatically when it exists. Every value below is optional:
# with NO .env at all Leadscout runs with the safe defaults shown here.
# Lines starting with "# NAME=" are unset by default; remove the "# " to use them.
# NEVER commit your real `.env` (it is git-ignored).

# ---------------------------------------------------------------- server
# HTTP port the server listens on (binds to localhost).
LEADSCOUT_PORT=8790
# Interface to bind. 127.0.0.1 = this machine only (safe default). 0.0.0.0 = all interfaces (only behind a proxy/firewall).
LEADSCOUT_HOST=127.0.0.1
# SQLite file. Created empty on first run. The Docker image uses /data/leadscout.db.
LEADSCOUT_DB=data/leadscout.db
# Strong random value for privileged admin routes (PUT limits). Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# LEADSCOUT_ADMIN_TOKEN=
# 1 = every /api/workspaces/* route needs a workspace API key. 0 = open (fine on localhost only).
LEADSCOUT_REQUIRE_KEYS=0
# Maximum wall time, in minutes, for one discovery/enrichment job.
LEADSCOUT_JOB_MAX_MINUTES=30
# Contact string put in the User-Agent of polite requests (a URL or email people can reach you on). Default "local".
# LEADSCOUT_CONTACT=

# ---------------------------------------------------------------- plugins (region / vertical / browser channels)
# Comma list of folders in plugins/ to load, or "all". Unset = core channels only.
# Available: wedding-events, india-directories, browser-social. READ each plugin's README first (ToS notes).
# LEADSCOUT_PLUGINS=

# ---------------------------------------------------------------- LLM (optional, only "polishes" dossiers)
# 1 = never call a model; template dossiers only. Everything else works identically.
LEADSCOUT_LLM_OFF=1
# Where to POST {prompt, system, taskHint} and read back {answer, usage}. See adapters/llm-adapter.ts.
LEADSCOUT_LLM_URL=http://127.0.0.1:8787/chat
# Bearer token sent to the LLM endpoint, if it wants one.
# LEADSCOUT_LLM_TOKEN=
# Per-call timeout in milliseconds.
LEADSCOUT_LLM_TIMEOUT_MS=60000

# ---- LLM adapter (only read by `npm run llm-adapter`, the reference adapter in adapters/) ----
# openai = any OpenAI-compatible API (OpenAI, OpenRouter, DeepSeek, Ollama, vLLM...). anthropic = Claude API.
LLM_PROVIDER=openai
# Model name for the chosen provider.
LLM_MODEL=gpt-4o-mini
# Port the adapter listens on (loopback only).
LLM_ADAPTER_PORT=8787
# Optional shared secret: if set the adapter requires "Authorization: Bearer <this>" (match LEADSCOUT_LLM_TOKEN).
# LLM_ADAPTER_TOKEN=
# Maximum tokens per answer.
LLM_MAX_TOKENS=1024
# OpenAI-compatible provider key and base URL.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic provider key and base URL.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------------------------------------------------------------- discovery and research
# Comma-separated Overpass (OpenStreetMap) API endpoints. Unset = discovery stays OFF.
# Public example: https://overpass-api.de/api/interpreter (mind its usage policy).
# LEADSCOUT_OVERPASS_URLS=
# 1 = let first-run/pipeline resolve contact details with live web requests. 0 = offline.
LEADSCOUT_RESOLVE_LIVE=0
# 1 = fetch live RSS/feed sources in the feeds module.
LEADSCOUT_FEEDS_LIVE=0
# 1 = let the pipeline call the live channel adapters. 0 = offline.
LEADSCOUT_CHANNELS_LIVE=0
# 0 = turn off web/feed "reach" lookups (src/reach.ts). Anything else = on when a reach tool exists.
LEADSCOUT_REACH=0
# Reach mode: primary | fallback | off.
LEADSCOUT_REACH_MODE=primary
# Path of an `agent-reach` compatible command used by reach lookups. Unset = "agent-reach" on PATH.
# AGENT_REACH_CMD=
# 0 = disable the per-lead research call-budget planner. Unset = on.
# LEADSCOUT_RESEARCH_BUDGET=
# 0 = disable "best time to call" timing hints. Unset = on.
# LEADSCOUT_TIMING=
# Path of the learned source-trust file. Unset = default under data/.
# LEADSCOUT_SOURCE_TRUST_PATH=
# Replace the question tree used by the intake wizard (JSON file path). Unset = data/intake-questions.json.
# LEADSCOUT_INTAKE_TREE=
# Placeholders for the guided first run (`src/first-run.ts`).
FIRST_RUN_CATEGORY=cafe
FIRST_RUN_CITY=Example City

# ---------------------------------------------------------------- core channel switches (all default OFF)
# 1 = web-search discovery channel.
CHANNEL_CH_WEBSEARCH_DISCOVERY=0
# 1 = company-intel channel (public company registry/filing pages).
LEADSCOUT_COMPANY_INTEL=0
# 1 = developer-forum channel.
LEADSCOUT_DEVFORUMS=0
# 1 = podcast channel.
LEADSCOUT_CH_PODCASTS=0
# 1 = YouTube channel (public pages).
LEADSCOUT_YOUTUBE=0
# 1 = also transcribe YouTube audio locally (needs the Whisper setup in tools/WHISPER_SETUP.md).
LEADSCOUT_TRANSCRIBE=0
# 1 = open-data channel.
LEADSCOUT_OPENDATA_ENABLED=0
# Google Places API key (official API, billed by Google). Unset = off.
# GOOGLE_PLACES_API_KEY=
# Firecrawl page reader (optional paid service). Needs both LEADSCOUT_FIRECRAWL=1 and a key.
LEADSCOUT_FIRECRAWL=0
# FIRECRAWL_API_KEY=
# Firecrawl credit guards: daily cap (unset = derived), credits always kept in reserve, max pages per run.
# FIRECRAWL_DAILY_CAP=
FIRECRAWL_RESERVE=300
FIRECRAWL_MAX_PER_RUN=40

# ---------------------------------------------------------------- browser backend (used by browser-social / india-directories plugins)
# ToS-sensitive. Unset = off. 1 = on. 0 = hard kill switch (refuses even if something else says on).
# LEADSCOUT_BROWSER=
# Chrome DevTools Protocol address of a browser YOU started and logged in. Default http://127.0.0.1:9222.
# LEADSCOUT_CDP_URL=http://127.0.0.1:9222
# Per-platform overrides use the same pattern with a suffix, e.g. LEADSCOUT_CDP_URL_LINKEDIN=http://127.0.0.1:9223
# and hourly caps, e.g. LEADSCOUT_CAP_LINKEDIN=15 (defaults: linkedin 15, instagram 30, facebook 30, other 60).
# Second switch for the "Tier C" (browser-only, ToS-sensitive) India channels.
LEADSCOUT_INDIA_TIER_C=0

# ---------------------------------------------------------------- plugin channel flags (only matter when the plugin is loaded)
# wedding-events plugin
CHANNEL_CH_WEDMEGOOD=0
CHANNEL_CH_WEDDINGWIRE_IN=0
CHANNEL_CH_WEDDINGSUTRA=0
CHANNEL_CH_VENUES=0
CHANNEL_CH_EXPOS_AWARDS=0
CHANNEL_CH_EVENT_ORGANISERS=0
# india-directories plugin
# MAPPLS_API_KEY=
CHANNEL_BOOKMYSHOW=0
LEADSCOUT_PRACTO=0
LEADSCOUT_LYBRATE=0
LEADSCOUT_SHARECHAT_ENABLED=0
# browser-social plugin
CHANNEL_CH_INSTAGRAM_VENDORS=0
LEADSCOUT_WHATSAPP=0

# ---------------------------------------------------------------- outreach (email) - OFF by default
# SMTP relay, e.g. smtp://user:password@smtp.example.com:587. Unset = email stays OFF.
# LEADSCOUT_SMTP_URL=
# From address for outbound email.
LEADSCOUT_SMTP_FROM=you@example.com
# 1 = actually send. Keep 0 until you have read the legal section of the README.
LEADSCOUT_SEND_ENABLED=0
# Folder holding Do-Not-Call / Do-Not-Disturb registry exports. See data/dnd/README.md.
# LEADSCOUT_DND_DIR=

# ---------------------------------------------------------------- calls: recordings and transcription
# Folder watched for call recordings. Unset = data/call-recordings.
# LEADSCOUT_RECORDINGS_DIR=
# Workspace id the recording watcher files notes under (or pass it as the first CLI argument).
# LEADSCOUT_WORKSPACE=
# 1 = keep the audio file after transcription. Default: delete it.
LEADSCOUT_KEEP_AUDIO=0
# Local Whisper: path of the Python that has faster-whisper installed (see tools/WHISPER_SETUP.md).
# LEADSCOUT_WHISPER_PY=
# Cloud transcription (Groq). Needs both.
LEADSCOUT_TRANSCRIBE_CLOUD=0
# GROQ_API_KEY=

# ---------------------------------------------------------------- billing (optional)
# Test keys only until you are ready. Unset = billing integration off.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=

# ---------------------------------------------------------------- dev / test only (leave unset in production)
# 1 = serve built-in fixtures for UI tests.
# LEADSCOUT_TEST_FIXTURES=
# 1 = allow `channel-probe --live` against real sites.
# LEADSCOUT_PROBE_LIVE=
# Canary harness switch (src/canary.ts).
# LEADSCOUT_CANARY=
# Parallelism of `npm run check:all`.
CHECK_CONCURRENCY=3
